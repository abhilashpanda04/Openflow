<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Allow debugging (required for debug builds) -->
	<key>com.apple.security.get-task-allow</key>
	<true/>
	
	<!-- Microphone access (required for audio recording) -->
	<key>com.apple.security.device.microphone</key>
	<true/>
	
	<!-- Network client (required for backend API communication) -->
	<key>com.apple.security.network.client</key>
	<true/>
	
	<!-- Network server (for bundled Python backend) -->
	<key>com.apple.security.network.server</key>
	<true/>
	
	<!-- Allow launching background processes (Python backend) -->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	
	<!-- Required for bundled Python runtime -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
